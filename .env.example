# Data pipeline paths are resolved against the repository root.
BANGLAPSG_RAW_PATH=ml_training/data/raw/banglapsg.csv
BANGLAPSG_OUTPUT_DIR=ml_training/data/processed
BANGLAPSG_RANDOM_SEED=42

# Phase 6 backend: run commands from the repository root.
# Generate an ignored .env.admin file with: python scripts/create_admin.py
# Merge its assignments privately into .env or hosting secret settings.
# Empty credentials intentionally prevent startup. Keep your .env private.
BACKEND_ENVIRONMENT=development
BACKEND_DATABASE_URL=sqlite:///./backend/data/backend.sqlite3
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD_HASH=
BACKEND_JWT_SECRET=
BACKEND_JWT_EXPIRE_MINUTES=30
BACKEND_RATE_LIMIT_STORAGE_URI=memory://
BACKEND_SUBMISSION_RATE_LIMIT=5/minute
BACKEND_ANALYSIS_RATE_LIMIT=10/minute
BACKEND_LOGIN_RATE_LIMIT=3/minute
BACKEND_MAX_TEXT_LENGTH=1000
BACKEND_ABUSE_MAX_URLS=2
BACKEND_MAX_BODY_BYTES=32768
BACKEND_ALLOW_PUBLIC_READS=false
BACKEND_ALLOWED_ORIGINS=
BACKEND_TRUST_PROXY_HEADERS=false
BACKEND_REQUIRE_ML_READY=false
BACKEND_CATEGORY_MODEL=artifacts/category/char_svm.joblib
BACKEND_SEVERITY_MODEL=artifacts/severity/char_svm.joblib
BACKEND_REVIEW_POLICY=artifacts/review_policy.json
BACKEND_PRIORITY_RANKER=artifacts/priority_ranker.joblib
BACKEND_DUPLICATE_MODEL=artifacts/duplicates/P2.joblib
BACKEND_RULES_CONFIG=config/priority_rules.yaml
BACKEND_EMBEDDING_CACHE_DIR=.cache/backend
BACKEND_DUPLICATE_TOP_K=100

# Production requires PostgreSQL, shared Redis and ready artifacts.
# See docs/phase6_backend.md for deployment settings and proxy trust.
