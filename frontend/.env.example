# Public build-time URL. Never put credentials or JWT signing secrets here.
# /api uses Vite's local proxy; production must configure its reverse proxy.
VITE_API_BASE_URL=/api
# Publish only after the operator adopts docs/data_retention.md and provides
# a genuine privacy contact. Blank values keep an explicit demo notice visible.
VITE_PRIVACY_OPERATOR=
VITE_PRIVACY_CONTACT_URL=
# Development only; this value is NOT embedded in the browser bundle.
DEV_API_TARGET=http://127.0.0.1:8000
