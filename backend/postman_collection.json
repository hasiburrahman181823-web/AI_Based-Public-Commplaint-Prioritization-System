{
  "info": {
    "_postman_id": "138cd06b-6385-4e4f-8459-6c125f337b39",
    "name": "BanglaPSG API and security maintenance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on a disposable local database. Select the supplied environment and fill local admin credentials. Steps 04-07 submit synthetic examples. Steps 12-13 are real human review writes: confirmation explicitly moves all three Mirpur reports into one group after review, and splitting separates the English report. These actions demonstrate transport and persistence, not real-model accuracy. Private complaint reads require admin JWTs by default. No credentials or tokens are bundled. Versions captured by scripts can still become stale after concurrent writes; refresh and review on 409. New submissions/preview are capped at 1000 characters. Default per-IP limits: submission 5/minute, analyze 10/minute, login 3/minute; rapid repeats may return 429. Production API documentation is disabled. Deletion requests are preview-first and must be manually scoped; apply is an irreversible administration write. Citizen account requests use separate private citizen_email/citizen_password/citizen_token environment values. Use synthetic data; never export a populated environment."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{base_url}}/health",
        "description": "Development without trained artifacts may return degraded status. Production requires ready artifacts and configured dependencies."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Admin login",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/token",
        "description": "Enter your private admin_username and admin_password in the selected local environment first. Credentials are JSON-escaped in the pre-request script; no password is bundled.",
        "body": {
          "mode": "raw",
          "raw": "{{login_json}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"admin_password\")) { throw new Error(\"Set admin_password in your private selected environment\"); }",
              "pm.variables.set(\"login_json\", JSON.stringify({username: pm.environment.get(\"admin_username\"), password: pm.environment.get(\"admin_password\")}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const body = pm.response.json();",
              "pm.environment.set(\"admin_token\", body.access_token);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
