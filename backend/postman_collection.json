        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/admin/data-deletion",
        "description": "IRREVERSIBLE HUMAN ADMINISTRATION WRITE. Read docs/data_retention.md, verify ownership/scope/holds, review the preview, and stop/restart other workers as required. Set private environment deletion_complaint_id to the approved UUID and deletion_apply_approved=true only when applying this specific request. Approval is cleared before send. No real ID, token or credentials are bundled. This does not erase external exports, backups or separately trained models.",
        "body": {
          "mode": "raw",
          "raw": "{{deletion_json}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const identifier = pm.environment.get(\"deletion_complaint_id\");",
              "if (!identifier || !/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(identifier)) { throw new Error(\"Set deletion_complaint_id to the actual UUID reviewed for this request in your private local environment\"); }",
              "if (pm.environment.get(\"deletion_apply_approved\") !== \"true\") { throw new Error(\"Review the preview/scope and maintenance runbook, then explicitly set local deletion_apply_approved=true for one apply request\"); }",
              "pm.environment.unset(\"deletion_apply_approved\");",
              "pm.variables.set(\"deletion_json\", JSON.stringify({complaint_ids: [identifier], reason: \"verified_privacy_request\", apply: true}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.test(\"Expected dry-run mode\", () => pm.expect(pm.response.json().dry_run).to.eql(false)); }"
            ]
          }
        }
      ],
