    {
      "name": "20 Preview reviewed data deletion (no erasure)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/admin/data-deletion",
        "description": "Default dry-run: set private environment deletion_complaint_id to the actual reviewed UUID. The body uses literal JSON apply=false, not a string. Inspect would_delete_ids and missing_ids. No domain erasure or cache purge occurs. Do not infer requester ownership from possession of an ID.",
        "body": {
          "mode": "raw",
          "raw": "{{deletion_json}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const identifier = pm.environment.get(\"deletion_complaint_id\");",
              "if (!identifier || !/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(identifier)) { throw new Error(\"Set deletion_complaint_id to the actual UUID reviewed for this request in your private local environment\"); }",
              "pm.variables.set(\"deletion_json\", JSON.stringify({complaint_ids: [identifier], reason: \"verified_privacy_request\", apply: false}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.test(\"Expected dry-run mode\", () => pm.expect(pm.response.json().dry_run).to.eql(true)); }"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "21 APPLY reviewed data deletion (irreversible, explicit approval)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
