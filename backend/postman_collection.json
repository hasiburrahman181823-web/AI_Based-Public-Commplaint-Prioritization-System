          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const body = pm.response.json(); pm.environment.set(\"citizen_token\", body.access_token); }"
            ]
          }
        }
      ],
      "response": []
    },
