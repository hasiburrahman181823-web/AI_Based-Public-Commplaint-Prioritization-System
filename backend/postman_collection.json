      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.environment.get(\"citizen_email\");",
              "const password = pm.environment.get(\"citizen_password\");",
              "if (!email || !password) { throw new Error(\"Set citizen_email and citizen_password in your private local Postman environment.\"); }",
              "pm.variables.set(\"citizen_auth_json\", JSON.stringify({email, password}));"
            ]
